//
// Version resource for OpenInputBridge.sys, so Device Manager's driver file details show a
// version instead of a blank field. Fixed at 1.00 deliberately independent of the .inf's
// DriverVer stamp (OpenInputBridge.inx) — the two numbers serve different purposes (this is the
// binary's own version; DriverVer is what Windows uses for driver ranking/update comparisons)
// and are not meant to track each other.

#include <windows.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_SYSTEM
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenInputBridge Contributors"
            VALUE "FileDescription",  "OpenInputBridge Kernel-Mode Filter Driver"
            VALUE "FileVersion",      "1.00"
            VALUE "InternalName",     "OpenInputBridge.sys"
            VALUE "LegalCopyright",   "Copyright (c) 2026 OpenInputBridge Contributors"
            VALUE "OriginalFilename", "OpenInputBridge.sys"
            VALUE "ProductName",      "OpenInputBridge"
            VALUE "ProductVersion",   "1.00"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
