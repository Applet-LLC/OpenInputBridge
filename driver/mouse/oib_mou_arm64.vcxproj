ARM64 build of the mouse filter driver. Deliberately a separate project file rather than an
additional Platform inside oib_mou.vcxproj: it lives in the same driver/mouse/ directory and
every ClCompile/ClInclude/Inf item below references the exact same source files oib_mou.vcxproj
does (mousefilter.c/.h, ../common/*.c/.h, oib_mou.inx) by the same relative paths — i.e. this
project shares source with oib_mou.vcxproj by reference, it does not copy it. It is wired into
OpenInputBridge.sln with ONLY an ARM64 project configuration, mapped from every existing (x64)
solution configuration via Configuration Manager, so a single ordinary solution build produces
both the x64 and ARM64 .sys in the same pass without adding a new solution Platform. See
docs/DECISIONS.md for the ARM64 support decision (GitHub issue #2).
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|ARM64">
      <Configuration>Debug</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|ARM64">
      <Configuration>Release</Configuration>
      <Platform>ARM64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{56DB8589-6AAB-4391-A964-74CF5907CA89}</ProjectGuid>
    <RootNamespace>oib_mou_arm64</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">ARM64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>False</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <!-- See oib_mou.vcxproj's identical comment: Off skips WDF's auto test-signing for Release,
         so the shipped .sys carries exactly one (real, EV) signature from packaging/sign.mak. -->
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>True</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- $(MSBuildProjectDirectory)-relative, not $(SolutionDir)-relative — see oib_mou.vcxproj;
         packaging/sign.mak hardcodes ..\driver\mouse\ARM64\$(Configuration)\ as this project's
         output location. -->
    <OutDir>$(MSBuildProjectDirectory)\$(Platform)\$(Configuration)\</OutDir>
    <!-- WindowsDriver.Common.targets defaults PackageDir to $(OutDir)$(ProjectName)\, and
         $(ProjectName) is this .vcxproj file's own base name ("oib_mou_arm64"), not
         $(TargetName) ("oib_mou") — for oib_mou.vcxproj those happen to be the same string,
         which is why that project never needed this override. Pin it explicitly so the
         packaged driver folder is named oib_mou\ here too, matching what packaging/sign.mak
         and installer/install.cpp both expect. -->
    <PackageDir>$(OutDir)oib_mou\</PackageDir>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ItemGroup Label="WrappedTaskItems" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <!-- Same TargetName as the x64 project: the shared oib_mou.inx's CopyFiles/ServiceBinary
         entries hardcode oib_mou.sys regardless of architecture. -->
    <TargetName>oib_mou</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <TargetName>oib_mou</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|ARM64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>
      </ExceptionHandling>
      <!-- Source files are UTF-8 (no BOM); without this, cl.exe under a non-UTF-8 system
           code page (e.g. Shift-JIS/932) misreads non-ASCII characters (em dashes, etc.)
           in comments and fails with C4819 (treated as error via TreatWarningAsError). -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>OIB_BUILD_MOUSE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib</AdditionalDependencies>
    </Link>
    <!-- No <DriverSign> block: signing is controlled by the $(SignMode)=Off project property
         set above (Release Configuration PropertyGroup), not by DriverSign item metadata. -->
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|ARM64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>
      </ExceptionHandling>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>OIB_BUILD_MOUSE;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\common\driver.c" />
    <ClCompile Include="..\common\ioctl.c" />
    <ClCompile Include="..\common\slots.c" />
    <ClCompile Include="mousefilter.c" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Pinned DateStamp rather than the WDK default of "*" (today's date) — see oib_mou.vcxproj
      (Inf2Cat's Signability test rejects a postdated DriverVer). Bump this if it ever again
      trips a "postdated DriverVer" failure. Same shared oib_mou.inx as the x64 project.
    -->
    <Inf Include="oib_mou.inx">
      <SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate>
      <DateStamp>01/01/2026</DateStamp>
    </Inf>
    <FilesToPackage Include="$(TargetPath)" Condition="'$(ConfigurationType)'=='Driver' or '$(ConfigurationType)'=='DynamicLibrary'" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="oib_mou.rc" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\common\driver.h" />
    <ClInclude Include="..\common\ioctl.h" />
    <ClInclude Include="..\common\slots.h" />
    <ClInclude Include="mousefilter.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
