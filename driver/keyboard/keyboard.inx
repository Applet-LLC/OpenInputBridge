;
; Primitive driver INF (Windows 10 1903+; see
; https://learn.microsoft.com/windows-hardware/drivers/develop/creating-a-primitive-driver):
; installed/uninstalled via DiInstallDriver/DiUninstallDriver (installer/), not matched to any
; hardware ID. [DefaultInstall.NTamd64] stages keyboard.sys into the driver store and registers
; it as a SERVICE_KERNEL_DRIVER/SERVICE_SYSTEM_START service (see docs/PROTOCOL.md for why
; boot-early start matters here).
;
; Keyboard half of the former single-binary OpenInputBridge.sys/Class=System driver (see
; docs/DECISIONS.md's 2026-07-30 entry): declaring Class=Keyboard here (instead of System) is
; the whole point of the split — it's what makes `pnputil /enum-drivers /class keyboard` show
; this package, and is expected to steer HLK toward the keyboard-filter-appropriate test
; selection instead of the much larger generic System-class set. mouse.inx is the Mouse-class
; counterpart; the two are independent packages/services (installer/), not one INF trying to
; cover both classes (which Class's single-value-per-INF limit doesn't allow).
;
; No [Manufacturer] section: its presence — even empty — makes InfVerif treat this as a
; (broken) PnP-match INF instead ("error 1297: Device driver does not install on any devices,
; use primitive driver if this is intended"), which is exactly what led to this design. The
; sibling Applet LLC kbdaddid.inf (production, WHQL-signed) proves this combination — primitive
; driver structure with Class=Keyboard — passes InfVerif/Inf2Cat.
;
; No [DefaultUninstall] section: DiUninstallDriver reverses [DefaultInstall.NTamd64]'s actions
; automatically — an explicit uninstall section is neither required nor wanted for a primitive
; driver (see the Microsoft doc above, "レガシ互換性").
;
; Deliberately does NOT AddReg the Keyboard device setup class's UpperFilters here: InfVerif's
; DCH-compliance rule (required for primitive drivers, "error 1321: Registry root ... is not
; isolated to HKR") forbids an INF from writing to an absolute registry path outside the
; driver's own HKR-relative scope — and a primitive driver, having no matched device, has no
; HKR context to be relative to in the first place. Registering as a *class-level* upper filter
; (affecting every keyboard system-wide, not one matched device) is exactly the kind of
; system-wide side effect DCH isolation exists to prevent doing declaratively from an INF. So
; that step stays in installer/ as a direct registry-API call, done alongside (not instead of)
; DiInstallDriver/DiUninstallDriver — see installer/common.cpp.

[Version]
Signature   = "$WINDOWS NT$"
Class       = Keyboard
ClassGuid   = {4d36e96b-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
DriverVer   = ; stamped at build time
CatalogFile = keyboard.cat
PnpLockdown = 1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,

[SourceDisksFiles]
keyboard.sys = 1

[DefaultInstall.NTamd64]
CopyFiles = Keyboard.CopyFiles

[DefaultInstall.NTamd64.Services]
AddService = OpenInputBridgeKeyboard,,Keyboard.ServiceInstall

[Keyboard.CopyFiles]
keyboard.sys

[Keyboard.ServiceInstall]
DisplayName   = %ServiceDisplayName%
ServiceType   = 1 ; SERVICE_KERNEL_DRIVER
StartType     = 1 ; SERVICE_SYSTEM_START
ErrorControl  = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary = %13%\keyboard.sys

[Strings]
ProviderString     = "OpenInputBridge Contributors"
ServiceDisplayName = "OpenInputBridge Keyboard"
DiskName           = "OpenInputBridge Keyboard Installation Disk"
