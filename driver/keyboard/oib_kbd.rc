//
// Version resource for oib_kbd.sys, so Device Manager's driver file details show a version
// instead of a blank field. Fixed at 1.00 deliberately independent of the .inf's DriverVer
// stamp (oib_kbd.inx) — the two numbers serve different purposes (this is the binary's own
// version; DriverVer is what Windows uses for driver ranking/update comparisons) and are not
// meant to track each other.

#include <windows.h>
#include "..\common\version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    OIB_VERSION_MAJOR,OIB_VERSION_MINOR,0,0
 PRODUCTVERSION OIB_VERSION_MAJOR,OIB_VERSION_MINOR,0,0
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DRV
 FILESUBTYPE VFT2_DRV_KEYBOARD
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "OpenInputBridge Contributors"
            VALUE "FileDescription",  "OpenInputBridge Keyboard Filter Driver"
            VALUE "FileVersion",      OIB_VERSION_STRING
            VALUE "InternalName",     "oib_kbd.sys"
            VALUE "LegalCopyright",   "Copyright (c) 2026 OpenInputBridge Contributors"
            VALUE "OriginalFilename", "oib_kbd.sys"
            VALUE "ProductName",      "OpenInputBridge"
            VALUE "ProductVersion",   OIB_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
