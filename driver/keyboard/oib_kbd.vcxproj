Structure adapted from Microsoft's public kbfiltr sample project file
(microsoft/Windows-driver-samples, input/kbfiltr/sys/kbfiltr.vcxproj) — see docs/CLEAN_ROOM.md.
x64 build. The ARM64 build is oib_kbd_arm64.vcxproj, a separate project in this same directory
that references these same source files by relative path rather than duplicating them — see its
own header comment.

Keyboard half of the former single-binary OpenInputBridge.sys (see docs/DECISIONS.md's
2026-07-30 entry): compiles the shared driver/common sources (driver.c/ioctl.c/slots.c,
unmodified — see driver.h's comment on OIB_BUILD_KEYBOARD/OIB_BUILD_MOUSE) alongside this
project's own kbdfilter.c.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{1C3E5A7F-9B2D-4E6C-8A1F-5D3B7C9E2A48}</ProjectGuid>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>False</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <!-- See OpenInputBridge.vcxproj's original comment (docs/CLEAN_ROOM.md predecessor): Off
         skips WDF's auto test-signing for Release, so the shipped .sys carries exactly one
         (real, EV) signature from packaging/sign.mak. Debug stays at the framework default. -->
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>True</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- $(MSBuildProjectDirectory)-relative, not $(SolutionDir)-relative — see
         OpenInputBridge.vcxproj's original comment; packaging/sign.mak hardcodes
         ..\driver\keyboard\x64\$(Configuration)\ as this project's output location. -->
    <OutDir>$(MSBuildProjectDirectory)\$(Platform)\$(Configuration)\</OutDir>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ItemGroup Label="WrappedTaskItems" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <!-- Not "keyboard": every Windows install already has an inbox keyboard.inf/.sys — see
         oib_kbd.inx's header comment for the Driver Store name collision this avoids. -->
    <TargetName>oib_kbd</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>oib_kbd</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>
      </ExceptionHandling>
      <!-- Source files are UTF-8 (no BOM); without this, cl.exe under a non-UTF-8 system
           code page (e.g. Shift-JIS/932) misreads non-ASCII characters (em dashes, etc.)
           in comments and fails with C4819 (treated as error via TreatWarningAsError). -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>OIB_BUILD_KEYBOARD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib</AdditionalDependencies>
    </Link>
    <!-- No <DriverSign> block: signing is controlled by the $(SignMode)=Off project property
         set above (Release Configuration PropertyGroup), not by DriverSign item metadata. -->
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>
      </ExceptionHandling>
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PreprocessorDefinitions>OIB_BUILD_KEYBOARD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir);$(ProjectDir)..\common;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\common\driver.c" />
    <ClCompile Include="..\common\ioctl.c" />
    <ClCompile Include="..\common\slots.c" />
    <ClCompile Include="kbdfilter.c" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Pinned DateStamp rather than the WDK default of "*" (today's date) — see
      OpenInputBridge.vcxproj's original comment (Inf2Cat's Signability test rejects a
      postdated DriverVer). Bump this if it ever again trips a "postdated DriverVer" failure.
    -->
    <Inf Include="oib_kbd.inx">
      <SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate>
      <DateStamp>01/01/2026</DateStamp>
    </Inf>
    <FilesToPackage Include="$(TargetPath)" Condition="'$(ConfigurationType)'=='Driver' or '$(ConfigurationType)'=='DynamicLibrary'" />
  </ItemGroup>
  <ItemGroup>
    <ResourceCompile Include="oib_kbd.rc" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\common\driver.h" />
    <ClInclude Include="..\common\ioctl.h" />
    <ClInclude Include="..\common\slots.h" />
    <ClInclude Include="kbdfilter.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
