;
; Minimal INF, used only for driver signing/cataloging (attestation signing via the Windows
; Hardware Dev Center dashboard requires an INF for the submission). Actual installation
; (service creation and class-level UpperFilters registration for both the Keyboard and Mouse
; device setup classes) is performed by installer/, NOT by this INF's DDInstall section — see
; the "install method" architecture note in the project plan for why a plain per-hardware-ID
; INF install cannot cover "every keyboard/mouse", and docs/PROTOCOL.md for the class GUIDs.
;
; TODO(M6): fill in Provider/DriverVer/CatalogFile once code-signing setup exists.
;
; No [Manufacturer]/[DDInstall.HW] sections: this is a "primitive" driver INF (a driver that
; is not installed via PnP hardware-ID matching, only ever loaded as a plain kernel service —
; see installer/ for the actual service creation and class-level UpperFilters registration).
; Including an empty [Manufacturer] section here makes InfVerif treat the INF as a (broken)
; PnP-install INF instead ("error 1297: Device driver does not install on any devices, use
; primitive driver if this is intended"), so it is intentionally omitted.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
DriverVer   = ; TODO: set at build time
CatalogFile = OpenInputBridge.cat
PnpLockdown = 1

[Strings]
ProviderString = "OpenInputBridge Contributors"
