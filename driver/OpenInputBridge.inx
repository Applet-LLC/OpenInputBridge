;
; Minimal INF, used only for driver signing/cataloging (attestation signing via the Windows
; Hardware Dev Center dashboard requires an INF for the submission). Actual installation
; (service creation and class-level UpperFilters registration for both the Keyboard and Mouse
; device setup classes) is performed by installer/, NOT by this INF's DDInstall section — see
; the "install method" architecture note in the project plan for why a plain per-hardware-ID
; INF install cannot cover "every keyboard/mouse", and docs/PROTOCOL.md for the class GUIDs.
;
; TODO(M6): fill in Manufacturer/Provider/DriverVer/CatalogFile once code-signing setup exists.

[Version]
Signature   = "$WINDOWS NT$"
Class       = System
ClassGuid   = {4d36e97d-e325-11ce-bfc1-08002be10318}
Provider    = %ProviderString%
DriverVer   = ; TODO: set at build time
CatalogFile = OpenInputBridge.cat
PnpLockdown = 1

[Manufacturer]
%ProviderString% = Standard, NT$ARCH$

[Standard.NT$ARCH$]
; Intentionally no [DDInstall.HW] hardware-ID matches: this driver is not installed via
; PnP device matching. See installer/ for the actual class-level UpperFilters registration.

[Strings]
ProviderString = "OpenInputBridge Contributors"
