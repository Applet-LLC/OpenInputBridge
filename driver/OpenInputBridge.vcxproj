Structure adapted from Microsoft's public kbfiltr sample project file
(microsoft/Windows-driver-samples, input/kbfiltr/sys/kbfiltr.vcxproj) — see docs/CLEAN_ROOM.md.
x64 only for now (matches the EWDK "amd64" build environment currently in use); ARM64 can be
added later following the same sample's pattern.
-->
<Project DefaultTargets="Build" ToolsVersion="12.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{0EAE70FD-2B47-46A9-9AAD-BEFA01C2A552}</ProjectGuid>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <KMDF_VERSION_MAJOR>1</KMDF_VERSION_MAJOR>
    <KMDF_VERSION_MINOR>33</KMDF_VERSION_MINOR>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>False</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
    <!--
      $(SignMode) is a project PROPERTY read by the WDK build's SignTask (distinct from the
      similarly-named %(DriverSign.SignMode) ITEM metadata below, which the targets do NOT
      check — easy to confuse). Off skips the framework's auto test-signing for Release, so
      the shipped .sys carries exactly one (real, EV) signature from packaging/sign.mak
      instead of a leftover test one alongside it. Debug is left at the framework default
      (effectively TestSign) since that's what makes an iterative local Debug build loadable
      on a test-signing-enabled dev machine without needing the real certificate every time.
    -->
    <SignMode>Off</SignMode>
  </PropertyGroup>
  <PropertyGroup Label="Configuration" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetVersion>Windows10</TargetVersion>
    <UseDebugLibraries>True</UseDebugLibraries>
    <DriverTargetPlatform>Windows Driver</DriverTargetPlatform>
    <DriverType>KMDF</DriverType>
    <PlatformToolset>WindowsKernelModeDriver10.0</PlatformToolset>
    <ConfigurationType>Driver</ConfigurationType>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup>
    <!-- $(MSBuildProjectDirectory)-relative, not $(SolutionDir)-relative: packaging/sign.mak
         hardcodes ..\driver\x64\$(Configuration)\ as this project's output location, so it
         must stay put regardless of whether this project is built standalone or as part of
         OpenInputBridge.sln (where $(SolutionDir) would otherwise be the repo root instead). -->
    <OutDir>$(MSBuildProjectDirectory)\$(Platform)\$(Configuration)\</OutDir>
  </PropertyGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ImportGroup Label="PropertySheets" Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <ItemGroup Label="WrappedTaskItems" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <TargetName>OpenInputBridge</TargetName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <TargetName>OpenInputBridge</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>
      </ExceptionHandling>
      <!-- Source files are UTF-8 (no BOM); without this, cl.exe under a non-UTF-8 system
           code page (e.g. Shift-JIS/932) misreads non-ASCII characters (em dashes, etc.)
           in comments and fails with C4819 (treated as error via TreatWarningAsError). -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib</AdditionalDependencies>
    </Link>
    <!-- No <DriverSign> block: signing is controlled by the $(SignMode)=Off project property
         set above (Release Configuration PropertyGroup), not by DriverSign item metadata. -->
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <TreatWarningAsError>true</TreatWarningAsError>
      <WarningLevel>Level4</WarningLevel>
      <ExceptionHandling>
      </ExceptionHandling>
      <!-- Source files are UTF-8 (no BOM); without this, cl.exe under a non-UTF-8 system
           code page (e.g. Shift-JIS/932) misreads non-ASCII characters (em dashes, etc.)
           in comments and fails with C4819 (treated as error via TreatWarningAsError). -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies);$(DDK_LIB_PATH)\ntstrsafe.lib</AdditionalDependencies>
    </Link>
    <DriverSign>
      <FileDigestAlgorithm>sha256</FileDigestAlgorithm>
    </DriverSign>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="driver.c" />
    <ClCompile Include="kbdfilter.c" />
    <ClCompile Include="mousefilter.c" />
    <ClCompile Include="ioctl.c" />
    <ClCompile Include="slots.c" />
  </ItemGroup>
  <ItemGroup>
    <!--
      Pinned DateStamp rather than the WDK default of "*" (today's date): Inf2Cat's
      "Signability test" rejects a DriverVer date it considers postdated relative to this
      Inf2Cat build's own notion of "now", which does not necessarily track the build
      machine's system clock. A fixed date sidesteps that entirely and is also more
      reproducible (the .inf's content doesn't depend on which day it happened to be built).
      Bump this if it ever again trips a "postdated DriverVer" failure.
    -->
    <Inf Include="OpenInputBridge.inx">
      <SpecifyDriverVerDirectiveDate>true</SpecifyDriverVerDirectiveDate>
      <DateStamp>01/01/2026</DateStamp>
    </Inf>
    <FilesToPackage Include="$(TargetPath)" Condition="'$(ConfigurationType)'=='Driver' or '$(ConfigurationType)'=='DynamicLibrary'" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="driver.h" />
    <ClInclude Include="ioctl.h" />
    <ClInclude Include="kbdfilter.h" />
    <ClInclude Include="mousefilter.h" />
    <ClInclude Include="slots.h" />
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
