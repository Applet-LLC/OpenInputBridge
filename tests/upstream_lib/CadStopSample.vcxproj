Builds the UNMODIFIED oblitum/Interceptionライブラリ sample
third_party/interception/samples/cadstop/cadstop.cpp (+ samples/utils.c, both referenced here
IN PLACE, not copied) into cadstop.exe — attempts to swallow Ctrl+Alt+Del before it ever
reaches the class driver. Filters with INTERCEPTION_FILTER_KEY_ALL (0xFFFF), unlike every
other tests/upstream_lib/ sample so far (identify/identify2/hardwareid/caps2esc/axes all only
ever used DOWN|UP or a handful of mouse button bits), giving real coverage of the E0/E1/
TERMSRV_* filter bits that docs/PROTOCOL.md still flags as unverified guesswork. Also
demonstrates the one thing a user-mode SetWindowsHookEx-style hook categorically cannot do
(consume the Secure Attention Sequence) — this driver sits below kbdclass and can, if the
capture actually works as intended. See InterceptionLib.vcxproj for why a self-authored vcxproj
is used instead of the sample's own buildit.cmd. Does not modify
cadstop.cpp/utils.c/utils.h in any way — see third_party/README.md and docs/CLEAN_ROOM.md.

Structured identically to IdentifySample.vcxproj: shares OutDir with InterceptionLib.vcxproj
(own IntDir to avoid intermediate collisions), depends on it only for build ordering, and is
dev/test tooling only — included in OpenInputBridge.sln's Debug/Release configurations, not
ReleaseWHQL, never touched by packaging/sign.mak.
-->
<Project DefaultTargets="Build" ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <ProjectGuid>{B3E6A9C1-4F8D-4B2E-9C6A-5D1F8B3E6A94}</ProjectGuid>
    <RootNamespace>CadStopSample</RootNamespace>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <CharacterSet>MultiByte</CharacterSet>
    <UseDebugLibraries Condition="'$(Configuration)'=='Debug'">true</UseDebugLibraries>
    <UseDebugLibraries Condition="'$(Configuration)'=='Release'">false</UseDebugLibraries>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" />
  </ImportGroup>
  <PropertyGroup>
    <!-- Deliberately the SAME OutDir as InterceptionLib.vcxproj — see IdentifySample.vcxproj's
         identical note. -->
    <OutDir>$(MSBuildProjectDirectory)\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(Platform)\$(Configuration)\$(MSBuildProjectName)\</IntDir>
    <TargetName>cadstop</TargetName>
    <IncludePath>$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\um;$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\shared;$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\ucrt;$(WindowsSdkDir)Include\$(WindowsTargetPlatformVersion)\winrt;$(IncludePath)</IncludePath>
    <LibraryPath>$(WindowsSdkDir)Lib\$(WindowsTargetPlatformVersion)\um\x64;$(WindowsSdkDir)Lib\$(WindowsTargetPlatformVersion)\ucrt\x64;$(LibraryPath)</LibraryPath>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <ExceptionHandling>Sync</ExceptionHandling>
      <AdditionalIncludeDirectories>..\..\third_party\interception\library;..\..\third_party\interception\samples;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
      <AdditionalDependencies>interception.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(OutDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="..\..\third_party\interception\samples\cadstop\cadstop.cpp" />
    <ClCompile Include="..\..\third_party\interception\samples\utils.c" />
  </ItemGroup>
  <ItemGroup>
    <ClInclude Include="..\..\third_party\interception\samples\utils.h" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="InterceptionLib.vcxproj">
      <Project>{7C3B9E2F-4A1D-4E6C-8B5F-9D2A6C8E1B34}</Project>
    </ProjectReference>
  </ItemGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
